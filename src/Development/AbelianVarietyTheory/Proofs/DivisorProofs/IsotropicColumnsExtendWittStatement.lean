theorem _root_.GlobalTheory.T.isotropic_columns_extend_witt : ∀ (F E : Type) [Field F] [NumberField F] [Field E] [NumberField E] [Algebra F E] (σ : E →ₐ[F] E), IsCMExt F E σ →
    ∀ (n : ℕ) (J : Matrix (Fin n) (Fin n) E), IsHermND σ J → ∀ (r : ℕ) (C : Matrix (Fin n) (Fin (r + 1)) E),
      LinearIndependent E C.transpose → Formalism.UG.cT (σ : E →+* E) C * J * C = 0 →
        ∃ (m : ℕ) (hm : r < m) (X Y : Matrix (Fin n) (Fin m) E), IsWittFrame σ J X Y ∧ GlobalTheory.StdPar.initCols X ⟨r, hm⟩ = C := by
  first | exact @GlobalTheory.WittExt.exists_isWittFrame_initCols | exact GlobalTheory.WittExt.exists_isWittFrame_initCols | (intros; apply GlobalTheory.WittExt.exists_isWittFrame_initCols <;> assumption)
